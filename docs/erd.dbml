// MER (Modelo Entidad-Relación) — Rendio MVP
// Pegar en https://dbdiagram.io/d para visualización interactiva y export PNG/PDF.
// Fuente de verdad: migrations 0001-0016 (rendio-backend/supabase/migrations/).
//
// Cambios respecto a versiones previas:
//   - driver_shifts        → shifts          (migration 0016)
//   - vehicle_inspections  → inspections     (migration 0016, con enum kind)
//   - maintenance_logs     → maintenance     (migration 0016)
//   - inspection_photos.angle → photo_type   (enum estricto en 0016)
//   - incidents: nuevos campos shift_id, vehicle_id, assigned_to, photo_paths, status enum
//   - driver_availability: jornadas AM/PM por día (módulo rendio-turnos, 0008+0015)
//   - se agregan weekly_schedules, app_settings, approval_requests

Project rendio_mvp {
  database_type: 'PostgreSQL'
  Note: 'MVP de Rendio Enterprises — transporte de auxiliares al aeropuerto JMC.'
}

// ──────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────

Enum user_role {
  admin
  driver
  auxiliar
}

Enum trip_direction {
  home_to_airport
  airport_to_home
}

Enum reservation_status_h2a {
  requested
  assigned
  ready
  en_route
  at_pickup
  on_board
  delivered
  no_show
  cancelled
}

Enum reservation_status_a2h {
  scheduled
  in_air
  landed
  disembarking
  driver_assigned
  picked_up
  en_route_home
  delivered
  cancelled
}

Enum flight_status {
  scheduled
  boarding
  in_air
  delayed
  advanced
  landed
  cancelled
  diverted
}

Enum vehicle_status {
  available
  in_use
  maintenance
  blocked
}

Enum shift_status {
  vehicle_selected
  inspection_in_progress
  active
  closing
  closed
}

Enum incident_severity {
  low
  medium
  high
}

Enum incident_category {
  cant_leave_on_time
  address_change
  driver_late
  flight_delay
  flight_advanced
  terminal_change
  missed_flight
  traffic
  aux_not_responding
  aux_not_ready
  wrong_address
  vehicle_problem
  other
}

Enum incident_status {
  open
  in_progress
  resolved
}

Enum inspection_kind {
  initial
  final
}

Enum inspection_photo_type {
  front
  left
  right
  rear
  dashboard
}

Enum availability_state {
  available
  prefer_rest
  unavailable
}

Enum approval_state {
  pending
  approved
  rejected
}

Enum shift_period {
  am
  pm
}

// ──────────────────────────────────────────────────────────────────────
// Multi-tenancy
// ──────────────────────────────────────────────────────────────────────

Table organizations {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  slug text [unique, not null]
  timezone text [default: 'America/Bogota']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table airports {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  iata_code text [note: 'ej. MDE']
  name text [not null]
  latitude double [not null]
  longitude double [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ──────────────────────────────────────────────────────────────────────
// Profiles
// ──────────────────────────────────────────────────────────────────────

Table profiles {
  id uuid [pk, note: 'FK to auth.users(id) ON DELETE CASCADE']
  organization_id uuid [not null, ref: > organizations.id]
  role user_role [not null]
  full_name text [not null]
  email text [not null]
  phone text
  avatar_url text
  is_active boolean [default: true]
  is_coordinator boolean [default: false, note: 'módulo rendio-turnos (0011)']
  can_coordinate boolean [default: false, note: 'módulo rendio-turnos (0013)']
  priority int [default: 0, note: 'módulo rendio-turnos (0012)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table auxiliar_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  profile_id uuid [unique, not null, ref: - profiles.id]
  home_address text [not null]
  home_latitude double [not null]
  home_longitude double [not null]
  employee_code text
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table driver_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  profile_id uuid [unique, not null, ref: - profiles.id]
  license_number text
  license_expires_at date
  eps_provider text
  eps_expires_at date
  arl_provider text
  arl_expires_at date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ──────────────────────────────────────────────────────────────────────
// Fleet
// ──────────────────────────────────────────────────────────────────────

Table vehicles {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  internal_code text [unique, not null, note: 'HAP 001']
  license_plate text [unique, not null]
  brand text
  model text
  year int
  capacity int [default: 4]
  current_km int [not null, default: 0]
  last_maintenance_km int [not null, default: 0]
  maintenance_interval_km int [default: 7000]
  status vehicle_status [default: 'available']
  soat_expires_at date
  tecnomec_expires_at date
  insurance_expires_at date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table maintenance {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  vehicle_id uuid [not null, ref: > vehicles.id]
  performed_by uuid [ref: > profiles.id]
  maintenance_type text [not null]
  km_at_event int [not null]
  cost_cop numeric(12,0)
  performed_at timestamptz [not null, default: `now()`]
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ──────────────────────────────────────────────────────────────────────
// Operations: shifts (turno operativo) — migration 0016
// ──────────────────────────────────────────────────────────────────────

Table shifts {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  driver_id uuid [not null, ref: > driver_profiles.id]
  vehicle_id uuid [not null, ref: > vehicles.id]
  status shift_status [default: 'vehicle_selected']
  start_at timestamptz [not null, default: `now()`]
  end_at timestamptz
  opening_km int
  closing_km int
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Al cerrar (status→closed) un trigger bloquea el vehículo si supera el intervalo de mantto.'
}

// ──────────────────────────────────────────────────────────────────────
// Módulo rendio-turnos — migrations 0008+0011-0015
// ──────────────────────────────────────────────────────────────────────

Table driver_availability {
  id uuid [pk, default: `gen_random_uuid()`]
  profile_id uuid [not null, ref: > profiles.id]
  week_start_date date [not null, note: 'lunes de la semana']
  day_of_week smallint [not null, note: '0=lunes..6=domingo']
  am_state availability_state [default: 'available']
  pm_state availability_state [default: 'available']
  shift_preference shift_period [note: 'am|pm; opcional (0015)']
  notes text
  submitted_at timestamptz [default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (profile_id, week_start_date, day_of_week) [unique]
  }
}

Table weekly_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  week_start_date date [unique, not null]
  data jsonb [not null, note: 'snapshot del horario generado']
  published boolean [default: false]
  created_by uuid [ref: > profiles.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app_settings {
  id text [pk, default: 'singleton']
  morning_label text [default: '02:30 AM - 02:00 PM']
  afternoon_label text [default: '02:00 PM - 01:30 AM']
  morning_slots smallint [default: 2]
  afternoon_slots smallint [default: 2]
  updated_by uuid [ref: > profiles.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table approval_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  profile_id uuid [not null, ref: > profiles.id]
  state approval_state [default: 'pending']
  payload jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ──────────────────────────────────────────────────────────────────────
// Inspections — migration 0016
// ──────────────────────────────────────────────────────────────────────

Table inspections {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  shift_id uuid [not null, ref: > shifts.id]
  vehicle_id uuid [not null, ref: > vehicles.id]
  driver_id uuid [not null, ref: > driver_profiles.id]
  kind inspection_kind [not null, note: 'initial | final']
  odometer_km int [not null]
  checklist jsonb [not null, default: `'{}'::jsonb`]
  has_damage boolean [default: false]
  notes text
  performed_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (shift_id, kind) [unique]
  }
}

Table inspection_photos {
  id uuid [pk, default: `gen_random_uuid()`]
  inspection_id uuid [not null, ref: > inspections.id]
  organization_id uuid [not null, ref: > organizations.id]
  photo_type inspection_photo_type [not null]
  storage_path text [not null, note: 'bucket inspections (privado)']
  size_bytes int
  taken_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (inspection_id, photo_type) [unique]
  }
}

// ──────────────────────────────────────────────────────────────────────
// Flights & Reservations
// ──────────────────────────────────────────────────────────────────────

Table flights {
  id uuid [pk, default: `gen_random_uuid()`]
  airport_id uuid [not null, ref: > airports.id]
  flight_number text [not null, note: 'AV9540']
  direction trip_direction [not null]
  scheduled_at timestamptz [not null]
  actual_at timestamptz
  status flight_status [default: 'scheduled']
  terminal text
  gate text
  required_auxiliars int [default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (airport_id, flight_number, scheduled_at) [unique]
  }
}

Table reservations {
  id uuid [pk, default: `gen_random_uuid()`]
  auxiliar_profile_id uuid [not null, ref: > auxiliar_profiles.id]
  flight_id uuid [not null, ref: > flights.id]
  direction trip_direction [not null]
  status_h2a reservation_status_h2a [note: 'nullable; only when direction = home_to_airport']
  status_a2h reservation_status_a2h [note: 'nullable; only when direction = airport_to_home']
  pickup_address text [not null]
  pickup_latitude double
  pickup_longitude double
  calculated_pickup_at timestamptz
  required_arrival_at timestamptz [not null]
  ready_confirmed_at timestamptz
  disembark_gate text [note: 'a2h only']
  notes text
  cancelled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ──────────────────────────────────────────────────────────────────────
// Routing
// ──────────────────────────────────────────────────────────────────────

Table route_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  driver_profile_id uuid [not null, ref: > driver_profiles.id]
  vehicle_id uuid [not null, ref: > vehicles.id]
  flight_id uuid [ref: > flights.id]
  direction trip_direction [not null]
  planned_start_at timestamptz
  actual_start_at timestamptz
  actual_end_at timestamptz
  status text [default: 'planned', note: 'planned|in_progress|completed|cancelled']
  total_distance_m int
  total_duration_s int
  encoded_polyline text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table route_stops {
  id uuid [pk, default: `gen_random_uuid()`]
  route_assignment_id uuid [not null, ref: > route_assignments.id]
  reservation_id uuid [not null, ref: > reservations.id]
  stop_order int [not null]
  estimated_arrival_at timestamptz
  actual_arrival_at timestamptz
  actual_pickup_at timestamptz
  status text [note: 'pending|arrived|picked_up|no_show']

  Indexes {
    (route_assignment_id, stop_order) [unique]
    (route_assignment_id, reservation_id) [unique]
  }
}

Table driver_locations {
  id bigint [pk, increment]
  driver_profile_id uuid [not null, ref: > driver_profiles.id]
  route_assignment_id uuid [ref: > route_assignments.id]
  latitude double [not null]
  longitude double [not null]
  heading real
  speed_kmh real
  recorded_at timestamptz [not null, default: `now()`]

  Indexes {
    (driver_profile_id, recorded_at) [name: 'idx_driver_loc_recent']
  }
}

// ──────────────────────────────────────────────────────────────────────
// Incidents & Audit
// ──────────────────────────────────────────────────────────────────────

Table incidents {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  reporter_id uuid [not null, ref: > profiles.id]
  shift_id uuid [ref: > shifts.id]
  vehicle_id uuid [ref: > vehicles.id]
  reservation_id uuid [ref: > reservations.id]
  category incident_category [not null]
  severity incident_severity [default: 'low']
  status incident_status [default: 'open']
  description text [not null]
  photo_paths jsonb [default: `'[]'::jsonb`]
  assigned_to uuid [ref: > profiles.id]
  resolution_notes text
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table audit_events {
  id bigint [pk, increment]
  actor_profile_id uuid [ref: > profiles.id]
  event_type text [not null]
  entity_type text [not null]
  entity_id uuid [not null]
  payload jsonb
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (entity_type, entity_id, created_at) [name: 'idx_audit_entity']
  }
}
